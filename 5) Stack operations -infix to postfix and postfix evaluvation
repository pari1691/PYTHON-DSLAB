        "class PostfixEvaluation:\n",
        "    def __init__(self):\n",
        "        self.stack = []\n",
        "    def push(self, value):\n",
        "        self.stack.append(value)\n",
        "    def pop(self):\n",
        "        return self.stack.pop()\n",
        "    def evaluate(self, exp):\n",
        "        for ch in exp:\n",
        "            if ch.isdigit():\n",
        "                self.push(int(ch))\n",
        "            else:\n",
        "                val2 = self.pop()\n",
        "                val1 = self.pop()\n",
        "                if ch == '+':\n",
        "                    self.push(val1 + val2)\n",
        "                elif ch == '-':\n",
        "                    self.push(val1 - val2)\n",
        "                elif ch == '*':\n",
        "                    self.push(val1 * val2)\n",
        "                elif ch == '/':\n",
        "                    self.push(val1 / val2)\n",
        "                elif ch == '^':\n",
        "                    self.push(val1 ** val2)\n",
        "        return self.pop()\n",
        "exp = \"231*+9-\"\n",
        "obj = PostfixEvaluation()\n",
        "result = obj.evaluate(exp)\n",
        "print(\"Result:\", result)"
